---
import './CostCalculator.css';
import { models } from '../data/models';

const calcModels = models
  .filter(m => m.showInCalculator)
  .sort((a, b) => (a.calcOrder ?? 99) - (b.calcOrder ?? 99));

const defaultRequests = 100;
const defaultInTokens = 1000;
const defaultOutTokens = 500;

const calcInitialCost = (inPrice: number | undefined, outPrice: number | undefined): string => {
  if (inPrice === undefined || outPrice === undefined) return '–';
  const daily = (defaultRequests * defaultInTokens * inPrice + defaultRequests * defaultOutTokens * outPrice) / 1_000_000;
  return '$' + (daily * 30).toFixed(2);
};
---

<div class="cost-calculator">
  <div class="cost-calculator__setup">
    <h3>Usage Scenario</h3>

    <div class="cost-calculator__input-group">
      <label class="cost-calculator__label" for="slider-requests">Daily Requests</label>
      <input type="range" min="1" max="5000" value="100" class="cost-calculator__slider" data-field="requests" id="slider-requests" aria-label="Daily Requests" />
      <div class="cost-calculator__range-labels">
        <span id="reqCount" class="cost-calculator__value">100</span>
        <span class="cost-calculator__range-end">5,000/day</span>
      </div>
    </div>

    <div class="cost-calculator__input-group">
      <label class="cost-calculator__label" for="slider-in-tokens">Avg Input Tokens per Request</label>
      <input type="range" min="100" max="50000" value="1000" class="cost-calculator__slider" data-field="inTokens" id="slider-in-tokens" aria-label="Avg Input Tokens per Request" />
      <div class="cost-calculator__range-labels">
        <span id="inTokens" class="cost-calculator__value">1,000</span>
        <span class="cost-calculator__range-end">50,000</span>
      </div>
    </div>

    <div class="cost-calculator__input-group">
      <label class="cost-calculator__label" for="slider-out-tokens">Avg Output Tokens per Request</label>
      <input type="range" min="50" max="10000" value="500" class="cost-calculator__slider" data-field="outTokens" id="slider-out-tokens" aria-label="Avg Output Tokens per Request" />
      <div class="cost-calculator__range-labels">
        <span id="outTokens" class="cost-calculator__value">500</span>
        <span class="cost-calculator__range-end">10,000</span>
      </div>
    </div>

    <div class="cost-calculator__presets">
      <span class="cost-calculator__preset-label">Quick scenarios:</span>
      <button class="cost-calculator__preset" data-req="100" data-in="500" data-out="200">Simple chat</button>
      <button class="cost-calculator__preset" data-req="20" data-in="5000" data-out="500">Document QA</button>
      <button class="cost-calculator__preset" data-req="500" data-in="300" data-out="50">Classification</button>
    </div>
  </div>

  <div class="cost-calculator__results">
    <h3>Monthly Cost</h3>
    <div class="cost-calculator__grid">
      {calcModels.map((model) => (
        <div class={`cost-calculator__card ${model.calcClass}`} data-in={model.inputPrice} data-out={model.outputPrice}>
          <span class="cost-calculator__family">{model.calcFamily}</span>
          <div class="cost-calculator__model">{model.calcDisplayName}</div>
          <div class="cost-calculator__price">{calcInitialCost(model.inputPrice, model.outputPrice)}</div>
          <div class="cost-calculator__row">
            <span class="cost-calculator__rate">{model.calcRate}</span>
            {model.calcBadge && (
              <span class={`cost-calculator__badge ${model.calcBadgeClass}`}>{model.calcBadge}</span>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<script is:inline>
document.addEventListener('DOMContentLoaded', function() {
  function getVal(id) {
    return parseInt(document.getElementById(id).textContent.replace(/,/g, '')) || 0;
  }

  function updateCosts() {
    const requests = getVal('reqCount');
    const inTokens = getVal('inTokens');
    const outTokens = getVal('outTokens');

    const calcCost = (inPrice, outPrice) => {
      const daily = (requests * inTokens * inPrice + requests * outTokens * outPrice) / 1000000;
      return (daily * 30).toFixed(2);
    };

    document.querySelectorAll('.cost-calculator__card[data-in]').forEach(function(card) {
      const inPrice = parseFloat(card.getAttribute('data-in'));
      const outPrice = parseFloat(card.getAttribute('data-out'));
      const priceEl = card.querySelector('.cost-calculator__price');
      if (priceEl) priceEl.textContent = '$' + calcCost(inPrice, outPrice);
    });
  }

  function updateSlider(slider) {
    const field = slider.getAttribute('data-field');
    const val = parseInt(slider.value).toLocaleString();
    const map = { requests: 'reqCount', inTokens: 'inTokens', outTokens: 'outTokens' };
    document.getElementById(map[field]).textContent = val;
    updateCosts();
  }

  document.querySelectorAll('.cost-calculator__slider').forEach(function(slider) {
    slider.addEventListener('input', function() { updateSlider(this); });
  });

  document.querySelectorAll('.cost-calculator__preset').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.querySelector('input[data-field="requests"]').value = this.getAttribute('data-req');
      document.querySelector('input[data-field="inTokens"]').value = this.getAttribute('data-in');
      document.querySelector('input[data-field="outTokens"]').value = this.getAttribute('data-out');
      document.querySelectorAll('.cost-calculator__slider').forEach(function(s) { updateSlider(s); });
    });
  });

  updateCosts();
});
</script>
