---
import './ModelSelector.css';
import { models } from '../data/models';

const selectorModels = models.filter(m => m.showInSelector);
---

<div class="model-selector">
  <div class="model-selector__filters">
    <div class="model-selector__filter-group">
      <label class="model-selector__filter-label">Use Case:</label>
      <div class="model-selector__chips" role="group" aria-label="Filter by use case">
        <button class="model-selector__chip active" data-filter="useCase" data-value="all" aria-pressed="true">All</button>
        <button class="model-selector__chip" data-filter="useCase" data-value="writing" aria-pressed="false">Writing</button>
        <button class="model-selector__chip" data-filter="useCase" data-value="coding" aria-pressed="false">Coding</button>
        <button class="model-selector__chip" data-filter="useCase" data-value="reasoning" aria-pressed="false">Reasoning</button>
        <button class="model-selector__chip" data-filter="useCase" data-value="vision" aria-pressed="false">Vision</button>
        <button class="model-selector__chip" data-filter="useCase" data-value="long-context" aria-pressed="false">Long Context</button>
        <button class="model-selector__chip" data-filter="useCase" data-value="budget" aria-pressed="false">Budget</button>
      </div>
    </div>

    <div class="model-selector__filter-group">
      <label class="model-selector__filter-label">Speed:</label>
      <div class="model-selector__chips" role="group" aria-label="Filter by speed">
        <button class="model-selector__chip active" data-filter="speed" data-value="any" aria-pressed="true">Any</button>
        <button class="model-selector__chip" data-filter="speed" data-value="ultra-fast" aria-pressed="false">Ultra-fast</button>
        <button class="model-selector__chip" data-filter="speed" data-value="fast" aria-pressed="false">Fast</button>
        <button class="model-selector__chip" data-filter="speed" data-value="medium" aria-pressed="false">Medium</button>
        <button class="model-selector__chip" data-filter="speed" data-value="slow" aria-pressed="false">Slow</button>
        <button class="model-selector__chip" data-filter="speed" data-value="very-slow" aria-pressed="false">Very Slow</button>
      </div>
    </div>

    <div class="model-selector__filter-group">
      <label class="model-selector__filter-label">Cost:</label>
      <div class="model-selector__chips" role="group" aria-label="Filter by cost">
        <button class="model-selector__chip active" data-filter="cost" data-value="any" aria-pressed="true">Any</button>
        <button class="model-selector__chip" data-filter="cost" data-value="budget" aria-pressed="false">Budget (&lt;$1)</button>
        <button class="model-selector__chip" data-filter="cost" data-value="mid" aria-pressed="false">Mid-range ($1–10)</button>
        <button class="model-selector__chip" data-filter="cost" data-value="premium" aria-pressed="false">Premium (&gt;$10)</button>
      </div>
    </div>

    <div class="model-selector__clear">
      <button class="model-selector__clear-btn" id="clearFilters">Clear filters</button>
      <span class="model-selector__count" id="modelCount">Showing {selectorModels.length} of {selectorModels.length} models</span>
    </div>
  </div>

  <div class="model-selector__grid" id="modelsGrid">
    {selectorModels.map((model) => (
      <div class="model-selector__card" data-model-id={model.selectorId} data-speed={model.speed} data-cost={model.costTier} data-use-cases={(model.useCases || []).join(',')}>
        <div class="model-selector__card-header">
          <h3 class="model-selector__card-title">{model.name}</h3>
          <span class="model-selector__card-provider">{model.company}</span>
        </div>
        <div class="model-selector__card-specs">
          <div class="model-selector__spec">
            <span class="model-selector__spec-label">Context:</span>
            <span class="model-selector__spec-value">{model.context}</span>
          </div>
          <div class="model-selector__spec">
            <span class="model-selector__spec-label">Speed:</span>
            <span class="model-selector__spec-badge" data-speed={model.speed}>{model.speed}</span>
          </div>
          {model.inputPrice !== undefined && model.inputPrice !== null && (
            <div class="model-selector__spec">
              <span class="model-selector__spec-label">Price:</span>
              <span class="model-selector__spec-value">${model.inputPrice}/{model.outputPrice} per 1M</span>
            </div>
          )}
        </div>
        <div class="model-selector__card-tags">
          {(model.useCases || []).map((tag) => (
            <span class="model-selector__tag">{tag}</span>
          ))}
        </div>
        <p class="model-selector__card-description">{model.bestFor}</p>
      </div>
    ))}
  </div>
</div>

<script is:inline>
document.addEventListener('DOMContentLoaded', function() {
  const filters = { useCase: 'all', speed: 'any', cost: 'any' };

  function updateDisplay() {
    const cards = document.querySelectorAll('[data-model-id]');
    let visible = 0;

    cards.forEach(function(card) {
      const speed = card.getAttribute('data-speed');
      const cost = card.getAttribute('data-cost');
      const useCases = card.getAttribute('data-use-cases').split(',');

      let show = true;

      if (filters.speed !== 'any' && speed !== filters.speed) show = false;
      if (filters.cost !== 'any' && cost !== filters.cost) show = false;
      if (filters.useCase !== 'all' && !useCases.includes(filters.useCase)) show = false;

      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    document.getElementById('modelCount').textContent = 'Showing ' + visible + ' of ' + cards.length + ' models';
  }

  function updateUI() {
    document.querySelectorAll('[data-filter]').forEach(function(chip) {
      const type = chip.getAttribute('data-filter');
      const val = chip.getAttribute('data-value');
      const active = (type === 'useCase' && (val === 'all' ? filters.useCase === 'all' : filters.useCase === val)) ||
                     (type === 'speed' && (val === 'any' ? filters.speed === 'any' : filters.speed === val)) ||
                     (type === 'cost' && (val === 'any' ? filters.cost === 'any' : filters.cost === val));
      chip.classList.toggle('active', active);
      chip.setAttribute('aria-pressed', active ? 'true' : 'false');
    });
  }

  document.querySelectorAll('[data-filter]').forEach(function(chip) {
    chip.addEventListener('click', function() {
      const type = this.getAttribute('data-filter');
      const val = this.getAttribute('data-value');
      filters[type] = val;
      updateUI();
      updateDisplay();
    });
  });

  document.getElementById('clearFilters').addEventListener('click', function() {
    filters.useCase = 'all';
    filters.speed = 'any';
    filters.cost = 'any';
    updateUI();
    updateDisplay();
  });
});
</script>
