---
import './ModelSelector.css';

const models = [
  {
    id: 'opus',
    name: 'Claude Opus 4.7',
    provider: 'Anthropic',
    context: '400K',
    inputCost: 15,
    outputCost: 75,
    speed: 'slow',
    costTier: 'premium',
    useCases: ['reasoning', 'writing', 'analysis', 'coding'],
    bestFor: 'Complex reasoning, long documents'
  },
  {
    id: 'sonnet',
    name: 'Claude Sonnet 4.6',
    provider: 'Anthropic',
    context: '200K',
    inputCost: 3,
    outputCost: 15,
    speed: 'fast',
    costTier: 'mid',
    useCases: ['writing', 'coding', 'analysis'],
    bestFor: 'Default choice for most tasks'
  },
  {
    id: 'haiku',
    name: 'Claude Haiku 4.5',
    provider: 'Anthropic',
    context: '200K',
    inputCost: 0.80,
    outputCost: 4,
    speed: 'ultra-fast',
    costTier: 'budget',
    useCases: ['routing', 'classification', 'speed'],
    bestFor: 'Fast & cheap for simple tasks'
  },
  {
    id: 'gpt55',
    name: 'GPT-5.5',
    provider: 'OpenAI',
    context: '128K',
    inputCost: 2,
    outputCost: 8,
    speed: 'fast',
    costTier: 'mid',
    useCases: ['writing', 'coding', 'vision'],
    bestFor: 'All-purpose, fast'
  },
  {
    id: 'gpt55-instant',
    name: 'GPT-5.5 Instant',
    provider: 'OpenAI',
    context: '128K',
    inputCost: 0.05,
    outputCost: 0.15,
    speed: 'ultra-fast',
    costTier: 'budget',
    useCases: ['speed', 'budget', 'routing'],
    bestFor: 'Ultra-fast & ultra-cheap'
  },
  {
    id: 'gemini',
    name: 'Gemini 3.1 Pro',
    provider: 'Google',
    context: '1M',
    inputCost: 2,
    outputCost: 12,
    speed: 'medium',
    costTier: 'mid',
    useCases: ['long-context', 'vision', 'research'],
    bestFor: 'Massive documents & vision'
  },
  {
    id: 'deepseek',
    name: 'DeepSeek V4',
    provider: 'DeepSeek',
    context: '128K',
    inputCost: 0.55,
    outputCost: 2.19,
    speed: 'fast',
    costTier: 'budget',
    useCases: ['reasoning', 'budget', 'coding'],
    bestFor: 'Budget-conscious with good quality'
  },
  {
    id: 'deepseek-flash',
    name: 'DeepSeek V4 Flash',
    provider: 'DeepSeek',
    context: '128K',
    inputCost: 0.14,
    outputCost: 0.28,
    speed: 'fast',
    costTier: 'budget',
    useCases: ['speed', 'budget', 'routing'],
    bestFor: 'Extreme budget, minimal quality loss'
  },
  {
    id: 'o3',
    name: 'o3',
    provider: 'OpenAI',
    context: '128K',
    inputCost: null,
    outputCost: null,
    speed: 'very-slow',
    costTier: 'premium',
    useCases: ['reasoning'],
    bestFor: 'Hardest problems (math, logic)'
  },
  {
    id: 'o1',
    name: 'o1',
    provider: 'OpenAI',
    context: '128K',
    inputCost: 15,
    outputCost: 60,
    speed: 'slow',
    costTier: 'premium',
    useCases: ['reasoning'],
    bestFor: 'Hard reasoning at lower cost than o3'
  },
  {
    id: 'llama',
    name: 'Llama 4',
    provider: 'Meta',
    context: 'varies',
    inputCost: 0,
    outputCost: 0,
    speed: 'varies',
    costTier: 'budget',
    useCases: ['open-source', 'privacy'],
    bestFor: 'Private, self-hosted'
  }
];
---

<div class="model-selector">
  <div class="model-selector__filters">
    <div class="model-selector__filter-group">
      <label class="model-selector__filter-label">Use Case:</label>
      <div class="model-selector__chips">
        <button class="model-selector__chip active" data-filter="useCase" data-value="all">All</button>
        <button class="model-selector__chip" data-filter="useCase" data-value="writing">Writing</button>
        <button class="model-selector__chip" data-filter="useCase" data-value="coding">Coding</button>
        <button class="model-selector__chip" data-filter="useCase" data-value="reasoning">Reasoning</button>
        <button class="model-selector__chip" data-filter="useCase" data-value="vision">Vision</button>
        <button class="model-selector__chip" data-filter="useCase" data-value="long-context">Long Context</button>
        <button class="model-selector__chip" data-filter="useCase" data-value="budget">Budget</button>
      </div>
    </div>

    <div class="model-selector__filter-group">
      <label class="model-selector__filter-label">Speed:</label>
      <div class="model-selector__chips">
        <button class="model-selector__chip active" data-filter="speed" data-value="any">Any</button>
        <button class="model-selector__chip" data-filter="speed" data-value="ultra-fast">Ultra-fast</button>
        <button class="model-selector__chip" data-filter="speed" data-value="fast">Fast</button>
        <button class="model-selector__chip" data-filter="speed" data-value="medium">Medium</button>
        <button class="model-selector__chip" data-filter="speed" data-value="slow">Slow</button>
        <button class="model-selector__chip" data-filter="speed" data-value="very-slow">Very Slow</button>
      </div>
    </div>

    <div class="model-selector__filter-group">
      <label class="model-selector__filter-label">Cost:</label>
      <div class="model-selector__chips">
        <button class="model-selector__chip active" data-filter="cost" data-value="any">Any</button>
        <button class="model-selector__chip" data-filter="cost" data-value="budget">Budget (&lt;$1)</button>
        <button class="model-selector__chip" data-filter="cost" data-value="mid">Mid-range ($1–10)</button>
        <button class="model-selector__chip" data-filter="cost" data-value="premium">Premium (&gt;$10)</button>
      </div>
    </div>

    <div class="model-selector__clear">
      <button class="model-selector__clear-btn" id="clearFilters">Clear filters</button>
      <span class="model-selector__count" id="modelCount">Showing 11 of 11 models</span>
    </div>
  </div>

  <div class="model-selector__grid" id="modelsGrid">
    {models.map((model) => (
      <div class="model-selector__card" data-model-id={model.id} data-speed={model.speed} data-cost={model.costTier} data-use-cases={model.useCases.join(',')}>
        <div class="model-selector__card-header">
          <h3 class="model-selector__card-title">{model.name}</h3>
          <span class="model-selector__card-provider">{model.provider}</span>
        </div>
        <div class="model-selector__card-specs">
          <div class="model-selector__spec">
            <span class="model-selector__spec-label">Context:</span>
            <span class="model-selector__spec-value">{model.context}</span>
          </div>
          <div class="model-selector__spec">
            <span class="model-selector__spec-label">Speed:</span>
            <span class="model-selector__spec-badge" data-speed={model.speed}>{model.speed}</span>
          </div>
          {model.inputCost !== null && (
            <div class="model-selector__spec">
              <span class="model-selector__spec-label">Price:</span>
              <span class="model-selector__spec-value">${model.inputCost}/${model.outputCost} per 1M</span>
            </div>
          )}
        </div>
        <div class="model-selector__card-tags">
          {model.useCases.map((tag) => (
            <span class="model-selector__tag">{tag}</span>
          ))}
        </div>
        <p class="model-selector__card-description">{model.bestFor}</p>
      </div>
    ))}
  </div>
</div>

<script>
{`
  function initModelSelector() {
    const models = ${JSON.stringify(models)};

    const filters = {
      useCase: 'all',
      speed: 'any',
      cost: 'any'
    };

    function updateModelDisplay() {
    const cards = document.querySelectorAll('[data-model-id]');
    let visibleCount = 0;

    cards.forEach(card => {
      const speed = card.getAttribute('data-speed');
      const cost = card.getAttribute('data-cost');
      const useCases = card.getAttribute('data-use-cases').split(',');

      let visible = true;

      // Speed filter
      if (filters.speed !== 'any' && speed !== filters.speed) {
        visible = false;
      }

      // Cost filter
      if (filters.cost !== 'any' && cost !== filters.cost) {
        visible = false;
      }

      // Use case filter
      if (filters.useCase !== 'all' && !useCases.includes(filters.useCase)) {
        visible = false;
      }

      card.style.display = visible ? '' : 'none';
      if (visible) visibleCount++;
    });

    const totalCount = models.length;
    document.getElementById('modelCount').textContent = 'Showing ' + visibleCount + ' of ' + totalCount + ' models';
  }

  function updateChipUI() {
    document.querySelectorAll('[data-filter]').forEach(chip => {
      const filterType = chip.getAttribute('data-filter');
      const filterValue = chip.getAttribute('data-value');
      const currentValue = filters[filterType];

      if (
        (filterType === 'useCase' && (filterValue === 'all' ? currentValue === 'all' : currentValue === filterValue)) ||
        (filterType === 'speed' && (filterValue === 'any' ? currentValue === 'any' : currentValue === filterValue)) ||
        (filterType === 'cost' && (filterValue === 'any' ? currentValue === 'any' : currentValue === filterValue))
      ) {
        chip.classList.add('active');
      } else {
        chip.classList.remove('active');
      }
    });
  }

  document.querySelectorAll('[data-filter]').forEach(chip => {
    chip.addEventListener('click', (e) => {
      const filterType = e.target.getAttribute('data-filter');
      const filterValue = e.target.getAttribute('data-value');

      if (filterType === 'useCase') {
        filters.useCase = filterValue === 'all' ? 'all' : filterValue;
      } else if (filterType === 'speed') {
        filters.speed = filterValue === 'any' ? 'any' : filterValue;
      } else if (filterType === 'cost') {
        filters.cost = filterValue === 'any' ? 'any' : filterValue;
      }

      updateChipUI();
      updateModelDisplay();
    });
  });

  document.getElementById('clearFilters').addEventListener('click', () => {
    filters.useCase = 'all';
    filters.speed = 'any';
    filters.cost = 'any';
    updateChipUI();
    updateModelDisplay();
  });
  }

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initModelSelector);
  } else {
    initModelSelector();
  }
`}
</script>
