---
import './PathSelector.css';

const paths = [
  {
    id: 'start',
    emoji: '🎯',
    title: 'Start Here',
    description: 'New to AI? Begin with orientation and quick start guides.',
    links: [
      { label: 'Welcome', href: '/' },
      { label: 'Quick Start', href: '/start/quick-start' }
    ]
  },
  {
    id: 'learn',
    emoji: '📚',
    title: 'Learn',
    description: 'Follow a guided learning path based on your role and goals.',
    links: [
      { label: 'Beginner Path', href: '/learn/beginner' },
      { label: 'Builder Path', href: '/learn/builder' },
      { label: 'Researcher Path', href: '/learn/researcher' },
      { label: 'Workflows', href: '/learn/workflows' },
      { label: 'Knowledge Quiz', href: '/learn/quiz' }
    ]
  },
  {
    id: 'decide',
    emoji: '🛠️',
    title: 'Decide',
    description: 'Compare tools, models, and frameworks. Make informed choices.',
    links: [
      { label: 'Tools Guide', href: '/decide/tools/guide' },
      { label: 'Tool Comparison', href: '/decide/tools/comparison' },
      { label: 'Models Guide', href: '/decide/models/guide' },
      { label: 'Frameworks Guide', href: '/decide/frameworks/guide' },
      { label: 'Cost Calculator', href: '/decide/cost-calculator' }
    ]
  },
  {
    id: 'reference',
    emoji: '📖',
    title: 'Reference',
    description: 'Glossary, cheatsheets, principles, and quick lookups.',
    links: [
      { label: 'Glossary', href: '/reference/glossary' },
      { label: 'Cheatsheets', href: '/reference/cheatsheets' },
      { label: 'Who to Follow', href: '/reference/follow' },
      { label: 'Confusions', href: '/reference/confusions' },
      { label: 'Principles', href: '/reference/principles' },
      { label: 'Benchmarks', href: '/reference/benchmarks' },
      { label: 'Economics of AI', href: '/reference/economics-of-ai' }
    ]
  },
  {
    id: 'research',
    emoji: '🔬',
    title: 'Research',
    description: 'Latest trends, model releases, and open-source developments.',
    links: [
      { label: "What's New", href: '/research/whats-new' },
      { label: 'Open-Source Models', href: '/research/models/guide' },
      { label: 'Chinese AI Ecosystem', href: '/research/china-ecosystem' },
      { label: 'Trends', href: '/research/emerging-trends' },
      { label: 'History', href: '/research/history' },
      { label: 'Vocabulary', href: '/research/vocabulary' }
    ]
  },
  {
    id: 'deep-dive',
    emoji: '⚙️',
    title: 'Deep Dives',
    description: 'Technical deep dives from fundamentals to production systems.',
    links: [
      { label: 'How LLMs Work', href: '/deep-dive/how-llms-work' },
      { label: 'RAG Architecture', href: '/deep-dive/rag-architecture' },
      { label: 'Agents & Frameworks', href: '/deep-dive/agents-frameworks' },
      { label: 'Prompt Engineering', href: '/deep-dive/prompt-engineering' }
    ]
  },
  {
    id: 'resources',
    emoji: '🌐',
    title: 'Resources',
    description: 'Curated papers, tools, communities, templates, and case studies.',
    links: [
      { label: 'Overview & Downloads', href: '/resources' },
      { label: 'Papers', href: '/resources/papers' },
      { label: 'Communities', href: '/resources/communities' },
      { label: 'Tools & Frameworks', href: '/resources/tools-frameworks' },
      { label: 'Build an LLM from Scratch', href: '/resources/llm-from-scratch' },
      { label: 'Interview Prep', href: '/resources/interview-prep' },
      { label: 'Case Studies', href: '/resources/case-studies' },
      { label: 'Templates', href: '/resources/templates' }
    ]
  },
  {
    id: 'community',
    emoji: '🤝',
    title: 'Community',
    description: 'Contribute, report outdated info, and join the conversation.',
    links: [
      { label: 'Contributing Guide', href: '/community/contributing' },
      { label: 'Report Outdated', href: '/community/report' },
      { label: 'Help Wanted', href: '/community/help-wanted' },
      { label: 'Content Audit', href: '/community/audit' },
      { label: 'Analytics', href: '/community/analytics' },
      { label: 'Contributors', href: '/community/contributors' }
    ]
  }
];
---

<div class="path-selector">
  <div class="path-selector-header">
    <h2>Choose Your Path</h2>
    <p>Pick where you want to go. Each path is organized for a different purpose.</p>
  </div>

  <div class="paths-grid">
    {paths.map((path) => (
      <div class="path-card">
        <div class="path-emoji">{path.emoji}</div>
        <h3>{path.title}</h3>
        <p class="path-description">{path.description}</p>
        <nav class="path-links">
          {path.links.map((link) => (
            <a href={link.href} class="path-link">
              {link.label}
            </a>
          ))}
        </nav>
      </div>
    ))}
  </div>
</div>
