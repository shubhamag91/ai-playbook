---
import './SeeAlso.css';

export interface Props {
  links?: Array<{ label: string; href: string; description?: string }>;
}

const { links = [] } = Astro.props;

// Default related links based on section
const sectionRelations: Record<string, Array<{ label: string; href: string; description?: string }>> = {
  '/learn': [
    { label: 'Quick Start', href: '/start/quick-start', description: 'Get up to speed in 30 minutes' },
    { label: 'Reference', href: '/reference/glossary', description: 'Look up key terms and concepts' }
  ],
  '/decide': [
    { label: 'Research', href: '/research/whats-new', description: 'Latest model releases and trends' },
    { label: 'Benchmarks', href: '/reference/benchmarks', description: 'Compare model performance' }
  ],
  '/reference': [
    { label: 'Deep Dives', href: '/deep-dive/how-llms-work', description: 'Technical deep dives' },
    { label: 'Cheatsheets', href: '/reference/cheatsheets', description: 'Quick reference cards' }
  ],
  '/research': [
    { label: 'Deep Dives', href: '/deep-dive/how-llms-work', description: 'Technical deep dives' },
    { label: 'Model Specs', href: '/reference/model-specs', description: 'Detailed model specifications' }
  ],
  '/deep-dive': [
    { label: 'Research', href: '/research/whats-new', description: 'Latest trends and releases' },
    { label: 'Cheatsheets', href: '/reference/cheatsheets', description: 'Quick reference guides' }
  ]
};

// Determine the current section
const currentPath = Astro.url.pathname;
const section = Object.keys(sectionRelations).find(s => currentPath.startsWith(s));
const defaultLinks = section ? sectionRelations[section] : [];

// Use provided links or fall back to defaults
const displayLinks = links.length > 0 ? links : defaultLinks;

if (displayLinks.length === 0) {
  // Don't render if no links
  Astro.response.headers.set('X-No-See-Also', 'true');
}
---

{displayLinks.length > 0 && (
  <aside class="see-also">
    <div class="see-also-content">
      <h3>See Also</h3>
      <ul class="see-also-list">
        {displayLinks.map(link => (
          <li>
            <a href={link.href} class="see-also-link">
              <span class="see-also-label">{link.label}</span>
              {link.description && (
                <span class="see-also-description">{link.description}</span>
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </aside>
)}
