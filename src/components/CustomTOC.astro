---
import './CustomTOC.css';

const starlightRoute = Astro.locals.starlightRoute;
const tocItems = starlightRoute?.toc?.items || [];
const entryData = (starlightRoute?.entry?.data as Record<string, unknown>) || {};
const tldr: string[] = (entryData.tldr as string[]) || [];
const seeAlso: Array<{ label: string; href: string; description?: string }> = (entryData.seeAlso as Array<{ label: string; href: string; description?: string }>) || [];
const description: string = (entryData.description as string) || '';

// Flatten nested TOC items into a flat list for rendering
function flattenItems(items: any[], depth: number = 2): { slug: string; text: string; depth: number }[] {
  let result: { slug: string; text: string; depth: number }[] = [];
  for (const item of items) {
    result.push({ slug: item.slug, text: item.text, depth });
    if (item.children && item.children.length > 0) {
      result = result.concat(flattenItems(item.children, depth + 1));
    }
  }
  return result;
}

const headingTree = flattenItems(tocItems);
const hasTOC = headingTree.length > 0;
const hasOverview = tldr.length > 0 || seeAlso.length > 0 || description.length > 0;
---

<div class="custom-toc" id="custom-toc">
  <div class="custom-toc__tabs">
    <button class="custom-toc__tab active" data-tab="overview" aria-label="Show page overview">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
      Info
    </button>
    <button class="custom-toc__tab" data-tab="toc" aria-label="Show table of contents">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
      Pages
    </button>
    <button class="custom-toc__collapse" id="toc-collapse-btn" aria-label="Collapse sidebar">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
  </div>

  <!-- Overview panel -->
  <div class="custom-toc__panel active" data-panel="overview">
    {hasOverview ? (
      <>
        {description && (
          <div class="custom-toc__desc">{description}</div>
        )}
        {tldr.length > 0 && (
          <div class="custom-toc__tldr">
            <div class="custom-toc__label">Key Takeaways</div>
            <ul>
              {tldr.map(point => (
                <li>{point}</li>
              ))}
            </ul>
          </div>
        )}
        {seeAlso.length > 0 && (
          <div class="custom-toc__related">
            <div class="custom-toc__label">Related</div>
            {seeAlso.map(link => (
              <a href={link.href} class="custom-toc__link">
                {link.label}
                {link.description && <span class="custom-toc__link-desc">{link.description}</span>}
              </a>
            ))}
          </div>
        )}
      </>
    ) : (
      <div class="custom-toc__empty-message">No overview available</div>
    )}
  </div>

  <!-- TOC panel -->
  <div class="custom-toc__panel" data-panel="toc">
    {hasTOC ? (
      <nav class="custom-toc__nav">
        {headingTree.map(h => (
          <a
            href={`#${h.slug}`}
            class={`custom-toc__heading depth-${h.depth}`}
            data-depth={h.depth}
          >{h.text}</a>
        ))}
      </nav>
    ) : (
      <div class="custom-toc__empty-message">No sections on this page</div>
    )}
  </div>
</div>

<script is:inline>
(function() {
  // Check localStorage for persisted collapsed state
  if (localStorage.getItem('toc-collapsed') === 'true') {
    document.documentElement.dataset.tocCollapsed = '';
  }

  // Inject floating restore button
  var restoreBtn = document.createElement('button');
  restoreBtn.className = 'toc-restore-btn';
  restoreBtn.id = 'toc-restore-btn';
  restoreBtn.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>';
  restoreBtn.setAttribute('aria-label', 'Show sidebar');
  document.body.appendChild(restoreBtn);

  // Collapse button
  var collapseBtn = document.getElementById('toc-collapse-btn');
  if (collapseBtn) {
    collapseBtn.addEventListener('click', function() {
      document.documentElement.dataset.tocCollapsed = '';
      localStorage.setItem('toc-collapsed', 'true');
    });
  }

  // Restore button
  restoreBtn.addEventListener('click', function() {
    delete document.documentElement.dataset.tocCollapsed;
    localStorage.removeItem('toc-collapsed');
  });

  var tabs = document.querySelectorAll('.custom-toc__tab');
  var panels = {
    overview: document.querySelector('[data-panel="overview"]'),
    toc: document.querySelector('[data-panel="toc"]'),
  };

  // Restore last active tab from sessionStorage
  var activeTab = sessionStorage.getItem('custom-toc-tab') || 'overview';
  if (activeTab === 'toc' && panels.toc) {
    tabs.forEach(function(t) { t.classList.remove('active'); });
    document.querySelector('[data-tab="toc"]')?.classList.add('active');
    Object.values(panels).forEach(function(p) { if (p) p.classList.remove('active'); });
    if (panels.toc) panels.toc.classList.add('active');
  }

  tabs.forEach(function(tab) {
    tab.addEventListener('click', function() {
      var target = this.getAttribute('data-tab');
      tabs.forEach(function(t) { t.classList.remove('active'); });
      this.classList.add('active');
      Object.values(panels).forEach(function(p) { if (p) p.classList.remove('active'); });
      var panel = panels[target];
      if (panel) panel.classList.add('active');
      sessionStorage.setItem('custom-toc-tab', target);
    });
  });

  // Highlight current heading while scrolling
  var tocLinks = document.querySelectorAll('.custom-toc__heading');
  if (tocLinks.length > 0) {
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          var id = entry.target.getAttribute('id');
          tocLinks.forEach(function(link) {
            link.classList.toggle('active', link.getAttribute('href') === '#' + id);
          });
        }
      });
    }, { rootMargin: '-80px 0px -80% 0px' });

    document.querySelectorAll('h2, h3').forEach(function(h) {
      if (h.id) observer.observe(h);
    });
  }
})();
</script>