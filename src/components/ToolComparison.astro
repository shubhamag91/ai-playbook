---
import './ToolComparison.css';

const toolsByCategory = {
  chat: [
    { name: 'Claude', cost: '$20/mo', costSort: 20, speed: 'Medium', speedSort: 2, bestFor: 'Writing, long documents, analysis' },
    { name: 'ChatGPT', cost: '$20/mo', costSort: 20, speed: 'Fast', speedSort: 1, bestFor: 'Web search, general tasks' },
    { name: 'Gemini', cost: '$20/mo', costSort: 20, speed: 'Fast', speedSort: 1, bestFor: 'Research, massive documents' },
    { name: 'Perplexity', cost: '$20/mo', costSort: 20, speed: 'Fast', speedSort: 1, bestFor: 'Real-time web search, citations' },
    { name: 'DeepSeek', cost: 'Free/$10/mo', costSort: 5, speed: 'Fast', speedSort: 1, bestFor: 'Cost-conscious, reasoning' },
    { name: 'NotebookLM', cost: 'Free', costSort: 0, speed: 'Medium', speedSort: 2, bestFor: 'PDF analysis, document synthesis' },
    { name: 'Kimi', cost: 'Free/$10/mo', costSort: 5, speed: 'Medium', speedSort: 2, bestFor: 'Long context, web search' },
    { name: 'Ollama', cost: 'Free', costSort: 0, speed: 'Varies', speedSort: 2, bestFor: 'Private, self-hosted' }
  ],
  coding: [
    { name: 'Cursor', cost: '$20-40/mo', costSort: 30, speed: 'Medium', speedSort: 2, bestFor: 'Large codebases, multi-file refactors' },
    { name: 'Claude Code', cost: 'Pay-per-use', costSort: 10, speed: 'Medium', speedSort: 2, bestFor: 'Terminal, automation, CLI workflows' },
    { name: 'GitHub Copilot', cost: 'Free/$10-20/mo', costSort: 10, speed: 'Fast', speedSort: 1, bestFor: 'Widest IDE support' },
    { name: 'Windsurf', cost: '$15-30/mo', costSort: 22, speed: 'Fast', speedSort: 1, bestFor: 'Agentic workflows' },
    { name: 'JetBrains AI', cost: 'Free/$10-15/mo', costSort: 10, speed: 'Medium', speedSort: 2, bestFor: 'JetBrains IDEs' }
  ],
  content: [
    { name: 'Midjourney', cost: '$10-120/mo', costSort: 50, speed: 'Medium', speedSort: 2, bestFor: 'Photorealistic images, illustrations' },
    { name: 'Runway', cost: '$12-76/mo', costSort: 40, speed: 'Medium', speedSort: 2, bestFor: 'Video generation, post-production' },
    { name: 'Suno', cost: 'Free/$8-32/mo', costSort: 15, speed: 'Medium', speedSort: 2, bestFor: 'Original music, background scores' },
    { name: 'NotebookLM', cost: 'Free', costSort: 0, speed: 'Fast', speedSort: 1, bestFor: 'Document summarization' },
    { name: 'ElevenLabs', cost: 'Free/$11-99/mo', costSort: 30, speed: 'Medium', speedSort: 2, bestFor: 'Voice synthesis, narration' }
  ],
  apis: [
    { name: 'Anthropic API', cost: 'Pay-per-token', costSort: 10, speed: 'Medium', speedSort: 2, bestFor: 'Building with Claude' },
    { name: 'OpenAI API', cost: 'Pay-per-token', costSort: 10, speed: 'Medium', speedSort: 2, bestFor: 'Building with GPT' },
    { name: 'Google Vertex AI', cost: 'Pay-per-token', costSort: 10, speed: 'Medium', speedSort: 2, bestFor: 'Building with Gemini' },
    { name: 'LangChain', cost: 'Open-source', costSort: 0, speed: 'Varies', speedSort: 2, bestFor: 'LLM app framework' },
    { name: 'CrewAI', cost: 'Open-source', costSort: 0, speed: 'Varies', speedSort: 2, bestFor: 'Multi-agent orchestration' }
  ]
};
---

<div class="tool-comparison">
  <div class="tool-comparison__controls">
    <div class="tool-comparison__tabs">
      <button class="tool-comparison__tab active" data-tab="chat">Chat</button>
      <button class="tool-comparison__tab" data-tab="coding">Coding</button>
      <button class="tool-comparison__tab" data-tab="content">Content</button>
      <button class="tool-comparison__tab" data-tab="apis">APIs</button>
    </div>
    <div class="tool-comparison__search">
      <input type="text" class="tool-comparison__search-input" id="toolSearch" placeholder="🔍 Filter tools..." />
    </div>
  </div>

  {Object.entries(toolsByCategory).map(([category, tools]) => (
    <div class={`tool-comparison__table-wrapper ${category === 'chat' ? 'active' : ''}`} data-category={category}>
      <table class="tool-comparison__table">
        <thead>
          <tr>
            <th class="tool-comparison__header" data-sort="name">Tool</th>
            <th class="tool-comparison__header" data-sort="cost">Cost</th>
            <th class="tool-comparison__header" data-sort="speed">Speed</th>
            <th class="tool-comparison__header" data-sort="bestFor">Best For</th>
          </tr>
        </thead>
        <tbody>
          {tools.map((tool) => (
            <tr class="tool-comparison__row" data-name={tool.name.toLowerCase()} data-best-for={tool.bestFor.toLowerCase()}>
              <td class="tool-comparison__cell" data-value={tool.name}><strong>{tool.name}</strong></td>
              <td class="tool-comparison__cell" data-value={tool.costSort}>{tool.cost}</td>
              <td class="tool-comparison__cell" data-value={tool.speedSort}>
                <span class={`tool-comparison__speed-badge speed-${tool.speed.toLowerCase().replace(' ', '-')}`}>
                  {tool.speed}
                </span>
              </td>
              <td class="tool-comparison__cell" data-value={tool.bestFor}>{tool.bestFor}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ))}
</div>

<script is:inline>
document.addEventListener('DOMContentLoaded', function() {
  let currentTab = 'chat';
  let currentSort = null;
  let sortAsc = true;

  // Tab switching
  document.querySelectorAll('.tool-comparison__tab').forEach(tab => {
    tab.addEventListener('click', function() {
      const tabName = this.getAttribute('data-tab');

      document.querySelectorAll('.tool-comparison__tab').forEach(t => t.classList.remove('active'));
      this.classList.add('active');

      document.querySelectorAll('.tool-comparison__table-wrapper').forEach(w => w.classList.remove('active'));
      document.querySelector('[data-category="' + tabName + '"]').classList.add('active');

      currentTab = tabName;
    });
  });

  // Search filter
  document.getElementById('toolSearch').addEventListener('input', function() {
    const query = this.value.toLowerCase();
    const wrapper = document.querySelector('.tool-comparison__table-wrapper.active');
    wrapper.querySelectorAll('tbody tr').forEach(row => {
      const name = row.getAttribute('data-name');
      const bestFor = row.getAttribute('data-best-for');
      const match = name.includes(query) || bestFor.includes(query);
      row.style.display = match ? '' : 'none';
    });
  });

  // Sorting
  document.querySelectorAll('.tool-comparison__header').forEach(header => {
    header.addEventListener('click', function() {
      const sortKey = this.getAttribute('data-sort');
      const wrapper = document.querySelector('.tool-comparison__table-wrapper.active');
      const tbody = wrapper.querySelector('tbody');
      const rows = Array.from(tbody.querySelectorAll('tr'));

      if (currentSort === sortKey) {
        sortAsc = !sortAsc;
      } else {
        currentSort = sortKey;
        sortAsc = true;
      }

      rows.sort((a, b) => {
        let aVal = a.querySelector('[data-value]').getAttribute('data-value');
        let bVal = b.querySelector('[data-value]').getAttribute('data-value');

        const aNum = parseFloat(aVal);
        const bNum = parseFloat(bVal);

        if (!isNaN(aNum) && !isNaN(bNum)) {
          return sortAsc ? aNum - bNum : bNum - aNum;
        }

        return sortAsc ? aVal.localeCompare(bVal) : bVal.localeCompare(aVal);
      });

      rows.forEach(row => tbody.appendChild(row));
    });
  });
});
</script>
