---
import './ModelCompare.css';
import { models } from '../data/models';

export interface Props {
  showCompany?: boolean;
  showVision?: boolean;
  showCapabilities?: boolean;
  compact?: boolean;
}

const { showCompany = true, showVision = true, showCapabilities = false, compact = false } = Astro.props;

function hasVision(caps: string): string {
  return caps.includes('vision') ? '✅' : '❌';
}

function bestFor(caps: string, notes: string): string {
  if (notes) return notes.length > 60 ? notes.substring(0, 57) + '...' : notes;
  const capList = caps.split(',').map(c => c.trim());
  return capList.slice(0, 3).join(', ');
}
---

<table class="model-compare">
  <thead>
    <tr>
      <th>Model</th>
      {showCompany && <th>Company</th>}
      <th>Context</th>
      <th>Input/Output</th>
      {showVision && <th>Vision</th>}
      {showCapabilities && <th>Capabilities</th>}
      <th>Notes</th>
    </tr>
  </thead>
  <tbody>
    {models.map(m => (
      <tr>
        <td><strong>{m.name}</strong></td>
        {showCompany && <td>{m.company}</td>}
        <td>{m.context}</td>
        <td>{m.pricing}</td>
        {showVision && <td>{hasVision(m.capabilities)}</td>}
        {showCapabilities && <td>{m.capabilities}</td>}
        <td class="model-compare__notes">{m.notes || '-'}</td>
      </tr>
    ))}
  </tbody>
</table>