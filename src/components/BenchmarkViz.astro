---
import './BenchmarkViz.css';
import { benchmarkData } from '../data/benchmarks';

const familyToCompany: Record<string, string> = {
  'Claude': 'Anthropic', 'GPT': 'OpenAI', 'Gemini': 'Google',
  'DeepSeek': 'DeepSeek', 'Llama': 'Meta', 'Mistral': 'Mistral',
  'OpenAI': 'OpenAI', 'Moonshot': 'Moonshot AI', 'Zhipu': 'Zhipu AI',
  'Meta': 'Meta', 'xAI': 'xAI', 'Alibaba': 'Alibaba', 'MiniMax': 'MiniMax', 'Xiaomi': 'Xiaomi',
};

const categoryKey: Record<string, string> = {
  'coding': 'coding', 'math': 'math', 'knowledge': 'knowledge',
  'reasoning': 'reasoning', 'design': 'design',
};

const categoryLabels: Record<string, string> = {
  coding: 'Coding (HumanEval)', math: 'Math (MATH)', knowledge: 'Knowledge (MMLU)',
  reasoning: 'Reasoning (GPQA)', design: 'Design (Design Arena)',
};

type ModelRow = {
  model: string;
  company: string;
  family: string;
  coding: number | null;
  math: number | null;
  knowledge: number | null;
  reasoning: number | null;
  design: number | null;
};

const modelMap = new Map<string, ModelRow>();

for (const entry of benchmarkData) {
  const key = `${entry.model}|${entry.family}`;
  if (!modelMap.has(key)) {
    modelMap.set(key, {
      model: entry.model,
      company: familyToCompany[entry.family] || entry.family,
      family: entry.family,
      coding: null,
      math: null,
      knowledge: null,
      reasoning: null,
      design: null,
    });
  }
  const row = modelMap.get(key)!;
  row[categoryKey[entry.category]] = entry.score;
}

const modelData = Array.from(modelMap.values());
const allFamilies = Array.from(new Set(modelData.map(r => r.family))).sort();
const familiesList = ['All', ...allFamilies];
const categories = ['coding', 'math', 'knowledge', 'reasoning', 'design'];

function formatScore(val: number | null, category: string): string {
  if (val === null) return '\u2014';
  return category === 'design' ? `${val} Elo` : `${val}%`;
}

function attrName(v: string): string { return v.toLowerCase().replace(/[^a-z0-9]/g, '-'); }
---

<div class="benchmark-viz" id="benchmark-viz">
  <div class="benchmark-viz__controls">
    <div class="benchmark-viz__filter-group">
      <label for="bm-family">Family</label>
      <select id="bm-family" class="benchmark-viz__select">
        {familiesList.map(f => (
          <option value={attrName(f)}>{f}</option>
        ))}
      </select>
    </div>
    <div class="benchmark-viz__filter-group">
      <label for="bm-sort">Sort By</label>
      <select id="bm-sort" class="benchmark-viz__select">
        <option value="model">Model name</option>
        <option value="coding">Coding</option>
        <option value="math">Math</option>
        <option value="knowledge">Knowledge</option>
        <option value="reasoning">Reasoning</option>
        <option value="design">Design</option>
      </select>
    </div>
  </div>

  <div class="benchmark-viz__table-wrapper">
    <table class="benchmark-viz__table">
      <thead>
        <tr>
          <th class="benchmark-viz__header sortable" data-sort="model">Model</th>
          <th>Company</th>
          {categories.map(cat => (
            <th class="benchmark-viz__header sortable" data-sort={cat}>{categoryLabels[cat]}</th>
          ))}
        </tr>
      </thead>
      <tbody id="bm-tbody">
        {modelData.map(row => (
          <tr class="benchmark-viz__row"
            data-model={attrName(row.model)}
            data-family={attrName(row.family)}
            data-sort-model={row.model.toLowerCase()}
            data-sort-coding={row.coding ?? -1}
            data-sort-math={row.math ?? -1}
            data-sort-knowledge={row.knowledge ?? -1}
            data-sort-reasoning={row.reasoning ?? -1}
            data-sort-design={row.design ?? -1}
          >
            <td><span class="benchmark-viz__model-badge" data-family={attrName(row.family)}>{row.model}</span></td>
            <td class="benchmark-viz__company">{row.company}</td>
            {categories.map(cat => (
              <td class={`benchmark-viz__score${cat === 'design' ? ' benchmark-viz__score--elo' : ''}`}>
                {formatScore(row[cat], cat)}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="benchmark-viz__count" id="bm-count">Showing {modelData.length} results</p>
</div>

<script is:inline>
const viz = document.getElementById('benchmark-viz');
if (viz) {
  const familySelect = document.getElementById('bm-family');
  const sortSelect = document.getElementById('bm-sort');
  const tbody = document.getElementById('bm-tbody');
  const countEl = document.getElementById('bm-count');

  function getHeaders() {
    return Array.from(document.querySelectorAll('.benchmark-viz__header.sortable'));
  }

  function getSortVal(row, sortKey) {
    return parseFloat(row.getAttribute('data-sort-' + sortKey)) || row.getAttribute('data-sort-' + sortKey) || '';
  }

  function filterAndSort() {
    const fam = familySelect.value;
    const sort = sortSelect.value;
    const asc = sort === 'model';

    const rows = Array.from(tbody.querySelectorAll('tr'));
    const visible = rows.filter(row => {
      return fam === 'all' || row.getAttribute('data-family') === fam;
    });

    visible.sort((a, b) => {
      const aVal = getSortVal(a, sort);
      const bVal = getSortVal(b, sort);
      if (typeof aVal === 'number' && typeof bVal === 'number') {
        return asc ? aVal - bVal : bVal - aVal;
      }
      return typeof aVal === 'string' && typeof bVal === 'string'
        ? (asc ? aVal.localeCompare(bVal) : bVal.localeCompare(aVal))
        : 0;
    });

    rows.forEach(row => row.remove());
    visible.forEach(row => tbody.appendChild(row));

    const hidden = rows.length - visible.length;
    countEl.textContent = `Showing ${visible.length} of ${rows.length} results${hidden > 0 ? ` (${hidden} filtered)` : ''}`;
  }

  familySelect.addEventListener('change', filterAndSort);
  sortSelect.addEventListener('change', filterAndSort);
}
</script>