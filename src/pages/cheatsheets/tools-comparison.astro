---
export const prerender = true;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tools Comparison - One Page Guide</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif; line-height: 1.3; color: #333; background: #f5f5f5; }
        @page { size: A4; margin: 0.4in; }
        @media print { body { background: white; } }
        .container { background: white; padding: 0.4in; max-width: 8.5in; height: 11in; margin: 0 auto; display: flex; flex-direction: column; gap: 0.08in; }
        h1 { font-size: 22px; margin-bottom: 0.05in; color: #1a1a1a; }
        .subtitle { font-size: 10px; color: #666; margin-bottom: 0.08in; }
        h2 { font-size: 11px; font-weight: 600; margin-bottom: 0.03in; color: #222; border-bottom: 2px solid #FF9800; padding-bottom: 0.02in; }
        table { width: 100%; font-size: 8px; border-collapse: collapse; margin: 0.04in 0; }
        th, td { padding: 0.03in 0.04in; border: 1px solid #ddd; text-align: left; }
        th { background: #f5f5f5; font-weight: 600; }
        p { font-size: 10px; margin-bottom: 0.02in; }
        ul { margin-left: 0.1in; font-size: 10px; }
        li { margin-bottom: 0.015in; }
        .section { border: 1px solid #ddd; padding: 0.08in; background: #fafafa; margin-bottom: 0.08in; }
        .footer { font-size: 8px; color: #999; text-align: center; margin-top: auto; }
    </style>
</head>
<body>
    <div class="container">
        <div>
            <h1>Tools Comparison</h1>
            <div class="subtitle">Which AI tool to use for what — chat, coding, content creation, APIs</div>
        </div>

        <div class="section">
            <h2>Conversational AI (Chat)</h2>
            <table>
                <tr>
                    <th>Tool</th>
                    <th>Best For</th>
                    <th>Cost</th>
                </tr>
                <tr>
                    <td><strong>Claude</strong></td>
                    <td>Writing, analysis, long documents</td>
                    <td>$20/mo</td>
                </tr>
                <tr>
                    <td><strong>ChatGPT</strong></td>
                    <td>Speed, all-purpose, web search</td>
                    <td>$20/mo</td>
                </tr>
                <tr>
                    <td><strong>Gemini</strong></td>
                    <td>Research, massive documents (1M tokens)</td>
                    <td>$20/mo</td>
                </tr>
                <tr>
                    <td><strong>DeepSeek</strong></td>
                    <td>Cost-conscious, high quality</td>
                    <td>Free / $10/mo</td>
                </tr>
            </table>
        </div>

        <div class="section">
            <h2>Coding Tools</h2>
            <table>
                <tr>
                    <th>Tool</th>
                    <th>Type</th>
                    <th>Cost</th>
                </tr>
                <tr>
                    <td><strong>Cursor</strong></td>
                    <td>Full IDE (VSCode-based)</td>
                    <td>$20–40/mo</td>
                </tr>
                <tr>
                    <td><strong>Claude Code</strong></td>
                    <td>CLI + VSCode extension</td>
                    <td>Pay-per-token</td>
                </tr>
                <tr>
                    <td><strong>GitHub Copilot</strong></td>
                    <td>Editor plugin</td>
                    <td>Free tier + $10–20/mo</td>
                </tr>
                <tr>
                    <td><strong>Windsurf</strong></td>
                    <td>Agentic IDE</td>
                    <td>$15–30/mo</td>
                </tr>
            </table>
        </div>

        <div class="section">
            <h2>Content Creation</h2>
            <table>
                <tr>
                    <th>Tool</th>
                    <th>Type</th>
                    <th>Cost</th>
                </tr>
                <tr>
                    <td><strong>Midjourney</strong></td>
                    <td>Image generation</td>
                    <td>$10–120/mo</td>
                </tr>
                <tr>
                    <td><strong>Runway</strong></td>
                    <td>Video generation</td>
                    <td>$12–76/mo</td>
                </tr>
                <tr>
                    <td><strong>Suno</strong></td>
                    <td>Music generation</td>
                    <td>Free / $8–32/mo</td>
                </tr>
            </table>
        </div>

        <div class="section">
            <h2>Quick Picker</h2>
            <ul>
                <li><strong>Chat & learning:</strong> Claude or ChatGPT</li>
                <li><strong>Writing:</strong> Claude (best nuance)</li>
                <li><strong>Web research:</strong> Perplexity</li>
                <li><strong>Coding:</strong> Cursor or Claude Code</li>
                <li><strong>Speed:</strong> GPT-5.5 Instant</li>
                <li><strong>Budget:</strong> DeepSeek V4 (10–50x cheaper)</li>
                <li><strong>Building apps:</strong> Anthropic API or OpenAI API</li>
            </ul>
        </div>

        <div class="footer">AI Playbook Cheat Sheet | May 2026 | Print-friendly, one page</div>
    </div>
</body>
</html>
